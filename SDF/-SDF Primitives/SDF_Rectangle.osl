
// SDF Rectangle Shader
// SDF_Rectangle.osl by IMAN SHIRANI
// 2025-11-28

shader SDF_Rectangle
[[
        string category = "SDF\\Primitives",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    
    
    vector Size = vector(1.0, 0.5, 0.0) [[ string label = "Half Size XYZ", string help = "Half extents in coordinate units. Rectangle uses X/Y only." ]],
    
    
    float CornerRadius = 0.0 [[ string label = "Corner Radius", float min = 0.0 ]],

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    
    vector p = vector(Position_In[0], Position_In[1], 0.0);
    
    
    vector s = vector(Size[0], Size[1], 0.0);
    
    
    vector q = abs(p) - s;

    
    float outside_dist = length(max(q, 0.0));
    
    
    float inside_dist = min(max(q[0], q[1]), 0.0);

    
    SDF_Out = (outside_dist + inside_dist) - CornerRadius;
}