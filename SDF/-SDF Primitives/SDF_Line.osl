// SDF Line Shader
// SDF_Line.osl by IMAN SHIRANI
// 2025-09-11



shader SDF_Line
[[
        string category = "SDF\\Primitives",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    point Point_A = point(-1, 0, 0),
    point Point_B = point(1, 0, 0),
    float Thickness = 0.1,
    
    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    vector pa = Position_In - Point_A;
    vector ba = Point_B - Point_A;   
    
    float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    
    
    SDF_Out = length(pa - ba * h) - Thickness;
}