// SDF Star Shader
// SDF_Star.osl by IMAN SHIRANI
// 2025-09-11




shader SDF_Star
[[
        string category = "SDF\\Primitives",
    string logo     = "SDF.png"
]]
(
    
    point Position_In = point(u, v, 0.0) * 2.0 - vector(1.0) [[ string label = "Position In", string help = "Defaults to remapped UV [-1,1]. Connected Domain coordinates bypass this default and are not remapped again." ]],

    int Vertices = 5,
    float RadiusOuter = 0.8 [[ string label = "Outer Radius", string help = "Outer star radius in coordinate units." ]],
    float RadiusInner = 0.4 [[ string label = "Inner Radius", string help = "Inner star radius in coordinate units." ]],

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    vector p = vector(Position_In[0], Position_In[1], 0.0);

    
    float angle = atan2(p[1], p[0]);
    float r = length(p);

    
    float slice_angle = M_PI / Vertices;

    
    float folded_angle = fmod(abs(angle), 2.0 * slice_angle);

    
    float t = abs(folded_angle - slice_angle) / slice_angle;
    float star_radius = mix(RadiusInner, RadiusOuter, t);

    
    SDF_Out = r - star_radius;
}