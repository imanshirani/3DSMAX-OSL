// SDF Box Shader
// SDF_Box.osl by IMAN SHIRANI
// 2025-09-11



shader SDF_Cylinder
[[
        string category = "SDF\\Primitives",
    string logo     = "SDF.png"
]]

(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    float Height = 2.0 [[ string label = "Full Height", string help = "Full height in coordinate units." ]],
    float Radius = 0.5,

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    
    vector d = abs(vector(length(vector(Position_In[0], Position_In[2], 0.0)), Position_In[1], 0.0)) - vector(Radius, Height / 2.0, 0.0);

    
    float outside_dist = length(max(d, 0.0));
    float inside_dist = min(max(d[0], d[1]), 0.0);
    
    SDF_Out = outside_dist + inside_dist;
}