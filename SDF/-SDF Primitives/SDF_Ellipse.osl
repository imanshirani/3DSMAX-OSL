// SDF Ellipse Shader
// SDF_Ellipse.osl by IMAN SHIRANI
// 2025-09-11



shader SDF_Ellipse
[[
        string category = "SDF\\Primitives",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    
    vector Radii = vector(1.0, 0.5, 1.0),

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    vector scaled_p = Position_In / Radii;
    float dist_in_scaled_space = length(scaled_p) - 1.0;
    float min_radius = min(Radii[0], min(Radii[1], Radii[2]));

    SDF_Out = dist_in_scaled_space * min_radius;
}