// SDF_Smooth_Union.osl by IMAN SHIRANI
// 2025-09-11

shader SDF_Smooth_Union
[[
        string category = "SDF\\Operators",
    string logo     = "SDF.png"
]]

(
    float SDF_A = 0.0 [[ string label = "SDF A", string help = "First field; base shape for subtraction." ]],
    float SDF_B = 0.0 [[ string label = "SDF B", string help = "Second field; cutter shape for subtraction." ]],
    
   
    float Smoothness = 0.2,

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    float h = clamp(0.5 + 0.5 * (SDF_B - SDF_A) / Smoothness, 0.0, 1.0);
    SDF_Out = mix(SDF_B, SDF_A, h) - Smoothness * h * (1.0 - h);
}