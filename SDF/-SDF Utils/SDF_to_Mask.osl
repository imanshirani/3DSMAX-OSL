

// SDF_to_Mask.osl by IMAN SHIRANI
// 2025-09-11

shader SDF_to_Mask
[[
        string category = "SDF\\Utils",
    string logo     = "SDF.png"
]]
(
    float SDF_In = 0.0 [[ string label = "SDF In", string help = "Signed scalar field from a shape or SDF operator." ]],
    float Blur = 0.01, 

    output color Mask_Out = color(0.0) [[ string label = "Mask Out", string help = "Black-and-white mask color with softened edges." ]]
)
{
    
    float mask_value = 1.0 - smoothstep(-Blur, Blur, SDF_In);
    Mask_Out = color(mask_value);
}