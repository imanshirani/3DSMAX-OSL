// 2025-11-25


shader SDF_Preview_3D
[[
        string category = "SDF\\Utils",
    string logo     = "SDF.png"
]]
(
    float SDF_In = 0.0 [[ string label = "SDF In", string help = "Signed scalar field from a shape or SDF operator." ]],
    
    color BaseColor = color(0.2, 0.4, 0.8) [[ string label = "Color" ]],
    vector LightDir = vector(-0.5, 0.5, 1.0) [[ string label = "Light Direction" ]],
    float Smoothness = 0.001 [[ string label = "Normal Smoothness" ]],
    
   
    float dx = 0.0 [[ string widget = "null", int lockgeom = 0 ]], 
    float dy = 0.0 [[ string widget = "null", int lockgeom = 0 ]],
    
    output color Color_Out = color(0.0) [[ string label = "Color Out", string help = "Color output for a material color input." ]],
    output vector Normal_Out = vector(0.0) [[ string label = "Normal Out", string help = "Normal vector; not a sampling position." ]]
)
{
    
    if (SDF_In < 0.0) {
        
        
        vector n = normalize(vector(Dx(SDF_In), Dy(SDF_In), Smoothness));
        
        
        vector l = normalize(LightDir);
        float diffuse = max(dot(n, l), 0.0);
        
        
        float ambient = 0.2;
        
        
        float rim = 1.0 - max(dot(n, vector(0,0,1)), 0.0);
        rim = pow(rim, 3.0) * 0.5;
        
        Color_Out = BaseColor * (diffuse + ambient) + rim;
        Normal_Out = n; 
    } 
    else {
        
        Color_Out = color(0.0, 0.0, 0.0); 
        Normal_Out = vector(0, 0, 1); 
    }
}