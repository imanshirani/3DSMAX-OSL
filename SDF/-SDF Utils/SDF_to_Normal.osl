// SDF_to_Normal.osl by IMAN SHIRANI
// 2025-11-25


shader SDF_to_Normal
[[
        string category = "SDF\\Utils",
    string logo     = "SDF.png"
]]
(
    float SDF_In = 0.0 [[ string label = "SDF In", string help = "Signed scalar field from a shape or SDF operator." ]],
    
    
    float Smoothness = 0.001 [[ string label = "Precision / Delta" ]],
    
    
    int AsColor = 1 [[ string label = "Output as Normal Map Color", string widget = "checkbox" ]],
    
    output vector Normal_Out = vector(0.0) [[ string label = "Normal Out", string help = "Normal vector; not a sampling position." ]],
    output color Color_Out = color(0.5, 0.5, 1.0) [[ string label = "Color Out", string help = "Color output for a material color input." ]]
)
{
    
    
    vector n = vector(0.0);
    
    
    n = normalize(vector(Dx(SDF_In), Dy(SDF_In), Smoothness));
    
    
    Normal_Out = n;
    
    
    if (AsColor) {
        Color_Out = color(n[0] * 0.5 + 0.5, n[1] * 0.5 + 0.5, n[2] * 0.5 + 0.5);
    } else {
        Color_Out = color(n);
    }
}