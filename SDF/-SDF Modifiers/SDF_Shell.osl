

// SDF_Shell.osl by IMAN SHIRANI
// 2025-09-11


shader SDF_Shell
[[
        string category = "SDF\\Modifiers",
    string logo     = "SDF.png"
]]
(
    
    float SDF_In = 0.0 [[ string label = "SDF In", string help = "Signed scalar field from a shape or SDF operator." ]],
    
    
    float Thickness = 0.1,

    output float SDF_Out = 0.0 [[ string label = "SDF Out", string help = "Signed scalar field: negative inside, positive outside." ]]
)
{
    
    float abs_sdf = abs(SDF_In);
    
    
    SDF_Out = abs_sdf - (Thickness / 2.0);
}