shader SDF_Repeat_Radial_Advanced
[[
    string category = "SDF\\Domain",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],

    int Repetitions = 8,
    float Placement_Radius = 0.7,
    float Placement_Angle = 0.0,

    output point Position_Out = P [[ string label = "Position Out", string help = "Sampling coordinates for Position_In of the next Domain node or shape." ]],
    output float Slice_ID = 0.0 [[ string label = "Slice ID", string help = "Angular cell index for variation." ]]
)
{
    vector p = vector(Position_In[0], Position_In[1], 0.0);
    float angle = atan2(p[1], p[0]);
    float radius = length(p);
    int count = max(1, Repetitions);
    float slice_angle = 2.0 * M_PI / float(count);
    float cell = floor(angle / slice_angle + 0.5);
    Slice_ID = mod(cell, float(count));
    // Center each angular cell around its shape, including the seam.
    angle = angle - cell * slice_angle;

    float s = 0.0;
    float c = 0.0;
    sincos(angle, s, c);
    point folded_space = point(radius * c, radius * s, Position_In[2]);

    float rad = radians(Placement_Angle);
    sincos(rad, s, c);
    float new_x = folded_space[0] * c - folded_space[1] * s;
    float new_y = folded_space[0] * s + folded_space[1] * c;
    point rotated_space = point(new_x, new_y, folded_space[2]);

    Position_Out = rotated_space - vector(Placement_Radius, 0.0, 0.0);
}
