// 2025-11-25

shader SDF_Mirror
[[
        string category = "SDF\\Domain",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    
    int Axis = 0 [[ string widget = "mapper", string options = "X-Axis:0|Y-Axis:1|Z-Axis:2" ]],
    float Offset = 0.0 [[ string label = "Mirror Plane Offset" ]],
    
    output point Position_Out = P [[ string label = "Position Out", string help = "Sampling coordinates for Position_In of the next Domain node or shape." ]]
)
{
    point p = Position_In;
    
    
    
    if (Axis == 0) p[0] = abs(p[0] - Offset) + Offset;
    else if (Axis == 1) p[1] = abs(p[1] - Offset) + Offset;
    else             p[2] = abs(p[2] - Offset) + Offset;
    
    Position_Out = p;
}