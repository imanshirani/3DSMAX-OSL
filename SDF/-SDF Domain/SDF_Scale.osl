

// SDF_Scale.osl by IMAN SHIRANI
// 2025-09-11


shader SDF_Scale
[[
        string category = "SDF\\Domain",
    string logo     = "SDF.png"
]]

(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],
    float Scale = 1.0 [[ string label = "Shape Scale", string help = "Uniform size multiplier: 0.5 is half size, 2 is double size." ]],

    output point Position_Out = P [[ string label = "Position Out", string help = "Sampling coordinates for Position_In of the next Domain node or shape." ]],
    output float Distance_Scale_Out = 1.0 [[ string label = "Distance Scale Out", string help = "Multiply the downstream SDF by this factor for distance correction. Use Position_Out to scale shapes." ]]
)
{
    
    float safe_scale = (Scale < 0.0 ? -1.0 : 1.0) * max(abs(Scale), 1e-6);
    Position_Out = Position_In / safe_scale;
    // Multiply the downstream SDF by this factor for distance correction.
    Distance_Scale_Out = abs(safe_scale);
}
