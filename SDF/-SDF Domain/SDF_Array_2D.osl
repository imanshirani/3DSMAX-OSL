// 2025-09-11



shader SDF_Array_2D
[[
        string category = "SDF\\Domain",
    string logo     = "SDF.png"
]]
(
    point Position_In = P [[ string label = "Position In", string help = "Sampling coordinates; defaults to surface position P. Connect Domain Position_Out here." ]],

    
    int Count_X = 5 [[ string label = "Count X", string help = "Number of array copies along X." ]],
    int Count_Y = 3 [[ string label = "Count Y", string help = "Number of array copies along Y." ]],

   
    float Cell_Spacing_X = 2.0 [[ string label = "Cell Spacing X", string help = "Center-to-center spacing in coordinate units. Does not auto-fit UV." ]],
    float Cell_Spacing_Y = 2.0 [[ string label = "Cell Spacing Y", string help = "Center-to-center spacing in coordinate units. Does not auto-fit UV." ]],

    
    output point Position_Out = P [[ string label = "Position Out", string help = "Sampling coordinates for Position_In of the next Domain node or shape." ]],
    output point Cell_ID = point(0.0) [[ string label = "Cell ID", string help = "Variation indices; use Position_Out to sample shapes." ]]
)
{
    
    int nx = max(1, Count_X);
    int ny = max(1, Count_Y);
    float sx = max(abs(Cell_Spacing_X), 1e-6);
    float sy = max(abs(Cell_Spacing_Y), 1e-6);
    float hx = 0.5 * (nx - 1);
    float hy = 0.5 * (ny - 1);
    
    
    // Clamp to the closest existing cell, preserving the outer shapes.
    // IDs are zero-based; even counts have half-cell-offset centers.
    Cell_ID = point(clamp(floor(Position_In[0] / sx + hx + 0.5), 0.0, float(nx - 1)),
                    clamp(floor(Position_In[1] / sy + hy + 0.5), 0.0, float(ny - 1)),
                    0.0);

    
    Position_Out = point(Position_In[0] - (Cell_ID[0] - hx) * sx,
                         Position_In[1] - (Cell_ID[1] - hy) * sy,
                         Position_In[2]);
    
    Position_Out[2] = Position_In[2];
}
